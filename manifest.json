{
  "manifest_version": 3,
  "name": "Image Converter & Compressor",
  "version": "1.0.0",
  "description": "Convert, compress, resize, and batch-process images locally in your browser. No uploads.",
  "permissions": ["tabs"],
  "action": {
    "default_title": "Image Converter & Compressor"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}